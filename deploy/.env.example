# Copy to deploy/.env and edit.

# Hugging Face token: only needed for private or gated model repos.
HF_TOKEN=

# Shared secret between the gateway and the engine (the engine is never public).
# Generate one: openssl rand -hex 32
PHARO_CLOUD_UPSTREAM_API_KEY=change-me

# Admin dashboard: without a token it only opens from the machine itself
# (ssh -L 8000:127.0.0.1:8000 you@machine, then http://127.0.0.1:8000/admin).
# In Docker, connections arrive through the Docker network, so set a token.
PHARO_CLOUD_ADMIN_TOKEN=

# The model to serve (must match an id in config/models.json).
MODEL_ID=pharo-coder
MODEL_TOKENIZER=Qwen/Qwen2.5-Coder-7B-Instruct
MAX_MODEL_LEN=32768

# vLLM parallelism: concurrent sequences, and GPUs to split the model over.
MAX_NUM_SEQS=64
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90

# Behind a reverse proxy (TLS)? Then trust its X-Forwarded-For.
PHARO_CLOUD_TRUST_PROXY=false
PHARO_CLOUD_PUBLIC_PORT=8000
